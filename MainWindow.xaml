<Window x:Class="RaidPlanner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RaidPlanner"
        mc:Ignorable="d"
        Title="" Height="450" Width="800">
    <Grid Background="#FF414141">
        <Label Content="Let's Plan Some Raids!" HorizontalAlignment="Center" Height="73" VerticalAlignment="Top" Width="438" Foreground="#FFFFF9F0" FontSize="40" FontFamily="Yu Gothic Medium"/>
        <TabControl Margin="0,67,0,0">
            <TabItem Header="Plans 🗺️">
                <Grid Background="#FFFFF9F0"/>
            </TabItem>
            <TabItem Header="Wishlist 🎁">
                <Grid Background="#FFFFF9F0" Margin="10">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Przyciski wishlist -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">

                        <Button Content="Add Wishlist"
                Width="110"
                Height="30"
                Click="AddWishlistButton_Click"/>

                        <Button Content="Delete Wishlist"
                Width="110"
                Height="30"
                Margin="10,0,0,0"
                Click="DeleteWishlistButton_Click"/>

                    </StackPanel>

                    <!-- Lista wishlist -->
                    <ListBox Name="WishlistListBox"
             Grid.Row="1"
             DisplayMemberPath="Name"
             SelectionChanged="WishlistListBox_SelectionChanged"/>

                    <!-- Prawa strona -->
                    <StackPanel Grid.Column="1" Margin="20,0,0,0">

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">

                            <Button Content="Add Item"
                    Width="90"
                    Click="AddItemButton_Click"/>

                            <Button Content="Delete Item"
                    Width="90"
                    Margin="10,0,0,0"
                    Click="DeleteItemButton_Click"/>

                        </StackPanel>

                        <ListBox Name="WishlistItemsListBox">

                            <ListBox.ItemTemplate>
                                <DataTemplate>

                                    <StackPanel Orientation="Horizontal">

                                        <CheckBox IsChecked="{Binding IsFound}"
                          Margin="0,0,10,0"/>

                                        <TextBlock Text="{Binding Name}"
                           VerticalAlignment="Center"/>

                                    </StackPanel>

                                </DataTemplate>
                            </ListBox.ItemTemplate>

                        </ListBox>

                    </StackPanel>

                </Grid>
            </TabItem>
            <TabItem Header="Notebook 🗒️">
                <Grid Background="#FFFFF9F0">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="250"/>
                            <!-- Lista notatek -->
                            <ColumnDefinition Width="10"/>
                            <!-- odstęp -->
                            <ColumnDefinition Width="*"/>
                            <!-- Podgląd treści -->
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <!-- Przycisk Add Note -->
                            <RowDefinition Height="*"/>
                            <!-- Lista i podgląd -->
                        </Grid.RowDefinitions>

                        <!-- Przyciski -->

                        <StackPanel Orientation="Horizontal" Grid.Row="0" Grid.Column="0" Margin="0,0,0,5">
                            <Button Content="Add Note" Width="75" Height="30" Click="AddNoteButton_Click" Background="#FF34CF01"/>
                            <Button Content="Delete Note" Width="75" Height="30" Margin="10,0,0,0" Click="DeleteNoteButton_Click" Background="#FFE80000"/>
                            <Button Content="Edit Note" Margin="10,0,0,0" Click="EditNoteButton_Click" Width="80"/>
                        </StackPanel>

                        <!-- Lista notatek -->
                        <ListBox Name="NotesListBox" Grid.Row="1" Grid.Column="0" 
                                 DisplayMemberPath="Title"
                                 SelectionChanged="NotesListBox_SelectionChanged"/>

                        <!-- Podgląd treści notatki -->
                        <Border Grid.Row="1" Grid.Column="2" Background="#FFF0F0F0" Padding="10" CornerRadius="5">
                            <TextBox Name="NoteContentTextBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>
            <TabItem Header="History ⌚">
                <Grid Background="#FFFFF9F0"/>
            </TabItem>
        </TabControl>
    </Grid>
</Window>