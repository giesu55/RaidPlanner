<Window x:Class="RaidPlanner.AddNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Note" Height="250" Width="400">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Title:" Grid.Row="0" VerticalAlignment="Center"/>
        <TextBox Name="TitleTextBox" Grid.Row="0" Margin="50,0,0,0" Height="25"/>

        <TextBlock Text="Content:" Grid.Row="1" VerticalAlignment="Top"/>
        <TextBox Name="ContentTextBox" Grid.Row="1" Margin="0,20,0,0" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>

        <Button Content="Save" Grid.Row="2" Width="80" Height="30" HorizontalAlignment="Right" Click="SaveButton_Click"/>
    </Grid>
</Window>